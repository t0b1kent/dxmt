 using namespace dxil_spv;
 
+// MacRunner: retain logical resource identity before the default CLI aliases
+// SRV/UAV/CBV/sampler registers into one SPIR-V binding namespace.
+// Only the standalone static-descriptor path is supported by this option.
+struct LogicalBinding
+{
+	unsigned cls, space, reg, size, resource, kind, view;
+};
+static std::string logical_path;
+static std::vector<LogicalBinding> logical_bindings;
+
+static bool map_logical(unsigned cls, const dxil_spv_d3d_binding &src,
+                        dxil_spv_vulkan_binding &dst, unsigned view = 0)
+{
+	if (src.register_index == UINT32_MAX || src.register_space == UINT32_MAX ||
+	    src.range_size == UINT32_MAX || dst.bindless.use_heap ||
+	    dst.descriptor_type == DXIL_SPV_VULKAN_DESCRIPTOR_TYPE_BUFFER_DEVICE_ADDRESS ||
+	    dst.descriptor_type == DXIL_SPV_VULKAN_DESCRIPTOR_TYPE_INPUT_ATTACHMENT)
+		return false;
+	LogicalBinding key{cls, src.register_space, src.register_index, src.range_size,
+	                   src.resource_index, unsigned(src.kind), view};
+	unsigned index = 0;
+	for (; index < logical_bindings.size(); index++)
+	{
+		const auto &b = logical_bindings[index];
+		if (b.cls == key.cls && b.space == key.space && b.reg == key.reg &&
+		    b.size == key.size && b.resource == key.resource && b.kind == key.kind && b.view == key.view)
+			break;
+	}
+	if (index == logical_bindings.size()) logical_bindings.push_back(key);
+	dst.set = 0;
+	dst.binding = index;
+	return true;
+}
+
+static bool write_logical_bindings()
+{
+	FILE *file = fopen(logical_path.c_str(), "w");
+	if (!file) return false;
+	fprintf(file, "{\"version\":1,\"namespace\":\"explicit-class-register-space\",\"bindings\":[");
+	for (size_t i = 0; i < logical_bindings.size(); i++)
+	{
+		const auto &b = logical_bindings[i];
+		fprintf(file, "%s{\"class\":%u,\"space\":%u,\"register\":%u,\"count\":%u,\"resource_index\":%u,\"kind\":%u,\"view\":%u,\"set\":0,\"binding\":%zu}",
+		        i ? "," : "", b.cls, b.space, b.reg, b.size, b.resource, b.kind, b.view, i);
+	}
+	fprintf(file, "]}\n");
+	bool ok = !ferror(file);
+	return fclose(file) == 0 && ok;
+}

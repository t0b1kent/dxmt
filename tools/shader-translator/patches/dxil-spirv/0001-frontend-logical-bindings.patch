+static dxil_spv_bool logical_srv(void *u, const dxil_spv_d3d_binding *s, dxil_spv_srv_vulkan_binding *v)
+{
+	if (!remap_srv(u, s, v)) return DXIL_SPV_FALSE;
+	if (!map_logical(0, *s, v->buffer_binding)) return DXIL_SPV_FALSE;
+	// Auxiliary byte-offset buffer occupies its own namespace, never a D3D slot.
+	v->offset_binding.set = 1; v->offset_binding.binding = 0;
+	return DXIL_SPV_TRUE;
+}
+
+static dxil_spv_bool logical_sampler(void *u, const dxil_spv_d3d_binding *s, dxil_spv_vulkan_binding *v)
+{
+	return remap_sampler(u, s, v) && map_logical(3, *s, *v);
+}
+
+static dxil_spv_bool logical_cbv(void *u, const dxil_spv_d3d_binding *s, dxil_spv_cbv_vulkan_binding *v)
+{
+	if (!remap_cbv(u, s, v) || v->push_constant) return DXIL_SPV_FALSE;
+	return map_logical(2, *s, v->vulkan.uniform_binding);
+}
+
+static dxil_spv_bool logical_uav(void *u, const dxil_spv_uav_d3d_binding *s, dxil_spv_uav_vulkan_binding *v)
+{
+	if (!remap_uav(u, s, v) || !map_logical(1, s->d3d_binding, v->buffer_binding)) return DXIL_SPV_FALSE;
+	if (s->has_counter && !map_logical(1, s->d3d_binding, v->counter_binding, 1)) return DXIL_SPV_FALSE;
+	v->offset_binding.set = 1; v->offset_binding.binding = 0;
+	return DXIL_SPV_TRUE;
+}

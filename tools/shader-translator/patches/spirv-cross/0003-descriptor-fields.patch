+// The descriptor table (or the static sampler table) a resource lives in, as a pointer to `record`.
+string CompilerMSL::root_abi_table(const RootAbiResource &r, const char *record)
+{
+	if (r.where == 3)
+		return join("reinterpret_cast<constant ", record, "*>(&spvDescriptorSet1)");
+	return join("reinterpret_cast<constant ", record, "*>(spvDescriptorSet0.r", r.qword, ")");
+}
+
+// Expression of another field of the descriptor the variable's handle is read from. It is built
+// like the handle expression: an array variable gets an object indexed the way the handle is.
+string CompilerMSL::root_abi_field_prefix(const SPIRVariable &var, const RootAbiResource &r, RootAbiField field)
+{
+	// Root descriptors and root constants have no descriptor: no view offset, no length, no counter.
+	if (r.where == 1 || r.where == 2)
+		return "0ul";
+	const bool arrayed = !get_variable_data_type(var).array.empty();
+	const char *record = field == RootAbiCube ? "spvSamplerDesc" : "spvRawDesc";
+	const char *member = field == RootAbiCube ? "cube" : field == RootAbiMeta ? "meta" : "aux";
+	const char *array = field == RootAbiCube ? "spvSamplerCubeArray" : field == RootAbiMeta ? "spvMetaArray" : "spvAuxArray";
+	const string table = root_abi_table(r, record);
+	if (arrayed)
+		return join(array, "{ ", table, " + ", r.index, " }");
+	return join(table, "[", r.index, "].", member);
+}
+
+const CompilerMSL::RootAbiResource *CompilerMSL::root_abi_resource_of(uint32_t id)
+{
+	if (!root_abi_enabled)
+		return nullptr;
+	auto *var = maybe_get_backing_variable(id);
+	if (!var)
+		return nullptr;
+	for (auto &bound : root_abi_bound)
+		if (bound.first == var->self)
+			return &bound.second;
+	return nullptr;
+}
+
+// A field of the descriptor behind an expression that reads a resource (the variable itself or an
+// element of an array variable). The expression of the handle is the variable's expression followed
+// by the element index, so the field is the field's expression followed by the same index.
+string CompilerMSL::root_abi_field(uint32_t id, RootAbiField field)
+{
+	auto *var = maybe_get_backing_variable(id);
+	auto *resource = root_abi_resource_of(id);
+	auto handle = var ? root_abi_handle.find(var->self) : end(root_abi_handle);
+	if (!resource || handle == end(root_abi_handle))
+		SPIRV_CROSS_THROW("Root ABI: the descriptor of a resource expression is not known.");
+	if (resource->where == 1 || resource->where == 2)
+		return "0ul";
+	// A pass that is going to be repeated emits placeholders for expressions.
+	if (is_forcing_recompilation())
+		return "0ul";
+	// An element of an array variable is "(<variable>)[index]", the variable itself is "<variable>".
+	const string expression = to_expression(id);
+	const string &name = handle->second;
+	const string prefix = root_abi_field_prefix(*var, *resource, field);
+	if (expression.compare(0, name.size(), name) == 0)
+		return prefix + expression.substr(name.size());
+	if (expression.size() > name.size() + 2 && expression[0] == '(' && expression.compare(1, name.size(), name) == 0 &&
+	    expression[name.size() + 1] == ')')
+		return prefix + expression.substr(name.size() + 2);
+	SPIRV_CROSS_THROW(join("Root ABI: a resource expression does not start with the expression of its variable: '",
+	                       expression, "' against '", name, "'."));
+}

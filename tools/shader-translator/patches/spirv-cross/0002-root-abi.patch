+// MacRunner: root-signature ABI of the D3D12 layer (resources/ABI.md). The description is a text file:
+//   qwords <n>                             64-bit words of the root argument buffer
+//   vertex_pull <0|1>                      vertex functions read vertices from the table in slot 2
+//   prelude <path>                         MSL helpers for descriptors
+//   vertex_prelude <path>                  MSL helpers for vertex pulling
+//   res <binding> <where> <qword> <index>  one line per resource of descriptor set 0 (binding = logical index):
+//                                          where 0 table, 1 root descriptor, 2 root constants, 3 static sampler
+static void apply_root_abi(CompilerMSL &msl, const string &path)
+{
+	std::ifstream file(path);
+	if (!file)
+		throw std::runtime_error("cannot read the root ABI description");
+	uint32_t qwords = 0;
+	int vertex_pull = 0;
+	string prelude, vertex_prelude, key;
+	std::unordered_map<uint32_t, uint32_t> where;
+	while (file >> key)
+	{
+		if (key == "qwords")
+			file >> qwords;
+		else if (key == "vertex_pull")
+			file >> vertex_pull;
+		else if (key == "prelude")
+			file >> prelude;
+		else if (key == "vertex_prelude")
+			file >> vertex_prelude;
+		else if (key == "res")
+		{
+			uint32_t binding = 0;
+			CompilerMSL::RootAbiResource resource;
+			file >> binding >> resource.where >> resource.qword >> resource.index;
+			msl.add_root_abi_resource(binding, resource);
+			where[binding] = resource.where;
+		}
+		else
+			throw std::runtime_error("unknown line in the root ABI description: " + key);
+		if (!file)
+			throw std::runtime_error("broken line in the root ABI description: " + key);
+	}
+	msl.set_root_abi(qwords, vertex_pull != 0);
+
+	// Static samplers live in their own table (slot 1); everything else hangs off the root buffer (slot 0).
+	auto resources = msl.get_shader_resources();
+	const auto place = [&](const SmallVector<Resource> &list) {
+		for (auto &resource : list)
+		{
+			auto found = where.find(msl.get_decoration(resource.id, DecorationBinding));
+			msl.set_decoration(resource.id, DecorationDescriptorSet, found != where.end() && found->second == 3 ? 1 : 0);
+		}
+	};
+	place(resources.uniform_buffers);
+	place(resources.storage_buffers);
+	place(resources.separate_images);
+	place(resources.separate_samplers);
+	place(resources.storage_images);
+	place(resources.sampled_images);
+
+	const auto include = [&](const string &source) {
+		std::ifstream text(source);
+		if (!text)
+			throw std::runtime_error("cannot read " + source);
+		string line;
+		while (std::getline(text, line))
+			msl.add_header_line(line);
+	};
+	if (!prelude.empty())
+		include(prelude);
+	// A stage input is four components of its type, whatever width the shader declares:
+	// the producing stage always writes four (see the stage output padding in spirv_msl.cpp).
+	if (msl.get_execution_model() == ExecutionModelFragment)
+	{
+		for (auto &input : msl.get_shader_resources(msl.get_active_interface_variables()).stage_inputs)
+		{
+			auto &type = msl.get_type(input.base_type_id);
+			if (!type.array.empty() || type.columns != 1 || type.basetype == SPIRType::Struct)
+				continue;
+			MSLShaderInterfaceVariable variable;
+			variable.location = msl.get_decoration(input.id, DecorationLocation);
+			variable.component = msl.get_decoration(input.id, DecorationComponent);
+			variable.vecsize = 4;
+			msl.add_msl_shader_input(variable);
+		}
+	}
+	if (vertex_pull && msl.get_execution_model() == ExecutionModelVertex && !vertex_prelude.empty())
+	{
+		auto inputs = msl.get_shader_resources(msl.get_active_interface_variables()).stage_inputs;
+		if (!inputs.empty())
+			include(vertex_prelude);
+		for (auto &input : inputs)
+		{
+			uint32_t location = msl.get_decoration(input.id, DecorationLocation);
+			const char *fields[] = { "entry", "offset", "format", "step" };
+			for (uint32_t field = 0; field < 4; field++)
+				msl.add_header_line("constant uint spvVin" + std::to_string(location) + "_" + fields[field] +
+				                    " [[function_constant(" + std::to_string(location * 4 + field) + ")]];");
+		}
 	}
 }
 

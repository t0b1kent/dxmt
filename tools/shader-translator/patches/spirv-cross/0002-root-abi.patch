+// Vertex pulling: the function reads vertex data itself from the table in slot 2
+// (base address, stride, length per bound slot), as the SM5.0 path of the layer does.
+void CompilerMSL::root_abi_vertex_pull_args(string &ep_args)
+{
+	if (!root_abi_pulls_vertices() || !stage_in_var_id)
+		return;
+	const auto builtin = [&](const char *attribute, const char *existing, const char *added) -> string {
+		if (ep_args.find(join("[[", attribute, "]]")) != string::npos)
+			return existing;
+		if (!ep_args.empty())
+			ep_args += ", ";
+		ep_args += join("uint ", added, " [[", attribute, "]]");
+		return added;
+	};
+	root_abi_vertex_id = builtin("vertex_id", "gl_VertexIndex", "spvVertexId");
+	root_abi_instance_id = builtin("instance_id", "gl_InstanceIndex", "spvInstanceId");
+	root_abi_base_instance = builtin("base_instance", "gl_BaseInstance", "spvBaseInstance");
+	if (!ep_args.empty())
+		ep_args += ", ";
+	ep_args += "constant spvVertexBufferEntry* spvVertexBuffers [[buffer(2)]]";
+}

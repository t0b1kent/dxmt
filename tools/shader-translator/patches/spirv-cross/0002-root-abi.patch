+// The expression every use of a resource variable is emitted as. Nothing is loaded
+// here: the handle (or the buffer pointer) is read from the descriptor at the point of use.
+string CompilerMSL::root_abi_expression(const SPIRVariable &var, const RootAbiResource &r)
+{
+	auto &type = get_variable_data_type(var);
+	const bool arrayed = !type.array.empty();
+	const string word = join("spvDescriptorSet0.r", r.qword);
+
+	if (type.basetype == SPIRType::Sampler)
+	{
+		string table;
+		if (r.where == 3)
+			table = "reinterpret_cast<constant spvSamplerDesc*>(&spvDescriptorSet1)";
+		else if (r.where == 0)
+			table = join("reinterpret_cast<constant spvSamplerDesc*>(", word, ")");
+		else
+			SPIRV_CROSS_THROW("Root ABI: a sampler must come from a descriptor table or be static.");
+		if (arrayed)
+			return join("spvSamplerArray{ ", table, " + ", r.index, " }");
+		return join(table, "[", r.index, "].s");
+	}
+
+	if (r.where == 3)
+		SPIRV_CROSS_THROW("Root ABI: only samplers can be static.");
+
+	if (type.basetype == SPIRType::Image)
+	{
+		if (r.where != 0)
+			SPIRV_CROSS_THROW("Root ABI: a texture must come from a descriptor table.");
+		string texture = type_to_glsl(type, var.self);
+		string table = join("reinterpret_cast<constant spvDesc<", texture, ">*>(", word, ")");
+		if (arrayed)
+			return join("spvDescArray<", texture, ">{ ", table, " + ", r.index, " }");
+		return join(table, "[", r.index, "].h");
+	}
+
+	if (type.basetype != SPIRType::Struct)
+		SPIRV_CROSS_THROW("Root ABI: unsupported resource type.");
+	if (arrayed)
+		SPIRV_CROSS_THROW("Root ABI: arrays of buffers are not supported.");
+
+	bool old_is_using_builtin_array = is_using_builtin_array;
+	is_using_builtin_array = true;
+	string pointer = join(get_argument_address_space(var), " ", type_to_glsl(type, var.self), "*");
+	is_using_builtin_array = old_is_using_builtin_array;
+
+	switch (r.where)
+	{
+	case 0:
+		return join("(*reinterpret_cast<constant spvDesc<", pointer, ">*>(", word, ")[", r.index, "].h)");
+	case 1:
+		return join("(*reinterpret_cast<", pointer, ">(", word, "))");
+	default:
+		// Root constants live in the root argument buffer itself.
+		return join("(*reinterpret_cast<", pointer, ">(&", word, "))");
+	}
+}

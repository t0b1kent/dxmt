+    if (!vs_library) return failed("vs_library");
+    auto ps_library = metal.newLibrary(ps.response.library.data(), ps.response.library.size(), error);
+    if (!ps_library) return failed("ps_library");
+    auto vs_function = vs_library.newFunction(vs.response.entry);
+    auto ps_function = ps_library.newFunction(ps.response.entry);
+    if (!vs_function || !ps_function) return failed(vs_function ? "ps_entry" : "vs_entry");
+    info.vertex_function = vs_function.handle;
+    info.fragment_function = ps_function.handle;
+    pso = metal.newRenderPipelineState(info, error);
+    if (!pso) return failed("render_pipeline");
+    InitializeDSSO(pDesc);
+    InitializeRasterizerState(pDesc);
+    translated_by = &source;

+
+static BOOL
+macrunner_frame_dump_mkdirs(char *directory) {
+  if (!directory || !directory[0])
+    return NO;
+
+  for (char *cursor = directory + 1; *cursor; cursor++) {
+    if (*cursor != '/')
+      continue;
+    *cursor = '\0';
+    if (mkdir(directory, 0700) && errno != EEXIST) {
+      *cursor = '/';
+      return NO;
+    }
+    *cursor = '/';
+  }
+  return !mkdir(directory, 0700) || errno == EEXIST;

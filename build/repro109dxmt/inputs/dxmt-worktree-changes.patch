+static inline uint64_t WMTProbeHashU64(uint64_t hash, uint64_t value) {
+  for (unsigned i = 0; i < 8; i++) {
+    hash ^= (uint8_t)(value >> (i * 8));
+    hash *= UINT64_C(1099511628211);
+  }
+  return hash;
+}

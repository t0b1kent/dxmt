+    char *end = NULL;
+    unsigned long parsed = value && value[0] ? strtoul(value, &end, 0) : 0;
+    limit = end && end != value && parsed > 0 && parsed <= 4096 ? parsed : 64;
+  });
+  unsigned current = atomic_fetch_add_explicit(&count, 1, memory_order_relaxed);

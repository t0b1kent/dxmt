+  dispatch_once(&once, ^{
+    const char *value = getenv("MACRUNNER_HB_FORCE_MAGENTA_PSO_ID");
+    char *end = NULL;
+    unsigned long long parsed = value && value[0] ? strtoull(value, &end, 0) : 0;
+    if (value && value[0] && (!end || end == value || *end != '\0')) {
+      end = NULL;
+      parsed = strtoull(value, &end, 16);
